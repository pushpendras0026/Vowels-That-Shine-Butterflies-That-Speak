 "captions": [
  {
   "t0": 0.3,
   "t1": 5.0,
   "scene": "Title",
   "text": "So far, vowels. Here we push the same film recipe to all 43 phonemes in 8 classes, and report what came out."
  },
  {
   "t0": 5.2,
   "t1": 16.6,
   "scene": "Chart",
   "text": "The IPA chart, class by class. Each tile lights up in its film's colour while its recording plays (32 real recordings)."
  },
  {
   "t0": 16.6,
   "t1": 26.6,
   "scene": "Chart",
   "text": "Recording → averaged LPC polynomial → realizable film (n 1–2.5) → reflected colour under daylight (D65)."
  },
  {
   "t0": 26.6,
   "t1": 29.0,
   "scene": "Chart",
   "text": "* modelled (no clean recording: you hear the film's own voice)   † fallback plosive (context vowel averaged in)   ~ trajectory model"
  },
  {
   "t0": 29.2,
   "t1": 33.2,
   "scene": "Fricative",
   "text": "One fricative: /s/ as in 'sip'. Its LPC envelope is the hiss shaped by the mouth: most energy high up."
  },
  {
   "t0": 33.2,
   "t1": 37.0,
   "scene": "Fricative",
   "text": "Layer peeling turns the 16 reflection coefficients into 16 film layers: bars of refractive index, each of equal optical thickness."
  },
  {
   "t0": 37.0,
   "t1": 40.0,
   "scene": "Fricative",
   "text": "That film reflects daylight as #ab63ff. Played back, the film has a voice too."
  },
  {
   "t0": 40.0,
   "t1": 43.0,
   "scene": "Fricative",
   "text": "Its nearest butterfly: the Morpho-like ×0.9 film, spectral shape correlation ρ = 0.87, ΔE00 = 10.4."
  },
  {
   "t0": 43.0,
   "t1": 46.5,
   "scene": "Fricative",
   "text": "Caveat: same shape, not the same strength: peak R 0.18 for /s/ vs 0.91. (Best match overall: [z], ρ = 0.98.)"
  },
  {
   "t0": 46.7,
   "t1": 55.5,
   "scene": "Gamut",
   "text": "Every valid colour of each class in the a*b* plane: all frames of every recording, viewed at 0, 15, 30, 45, 60°."
  },
  {
   "t0": 55.5,
   "t1": 60.0,
   "scene": "Gamut",
   "text": "No class is limited to one or two colours: 39–85 distinct colours per class, and in every class 3 colours lie more than ΔE00 = 10 apart. So we show them all."
  },
  {
   "t0": 60.2,
   "t1": 64.5,
   "scene": "Angle",
   "text": "Iridescence: tilt each film from 0° to 60° and its reflected colour drifts, like a wing turning in the light."
  },
  {
   "t0": 64.5,
   "t1": 69.0,
   "scene": "Angle",
   "text": "Tilting alone multiplies the colours: one film per phoneme × 5 angles already gives 3–23 distinct colours per class."
  },
  {
   "t0": 69.2,
   "t1": 72.9,
   "scene": "Diphthong",
   "text": "A diphthong is a moving film. /aɪ/ as in 'price' glides from /a/ to /ɪ/, and its colour glides with it."
  },
  {
   "t0": 72.9,
   "t1": 76.5,
   "scene": "Diphthong",
   "text": "30 interpolation steps between the two vowel polynomials (log-area ratios); the sound is the film's own synthesised voice."
  },
  {
   "t0": 76.7,
   "t1": 85.0,
   "scene": "Caveats",
   "text": "What to keep in mind: these are experiments, labelled as such."
  },
  {
   "t0": 85.3,
   "t1": 90.0,
   "scene": "End",
   "text": "Every phoneme has a film, and every film has colours. Explore them all on the Experiments page."
  }
 ],
